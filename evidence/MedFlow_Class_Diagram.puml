@startuml
!pragma layout smetana
skinparam monochrome true
skinparam dpi 160
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members
title MedFlow Class Structure (Milestones 1 to 5)

package "model" {
  class Patient {
    -patientId : String
    -name, birthdate, sex, address, contact
    -allergies, relevantHistory : String
    -mergedInto : String
    -visitIds : ArrayList<String>
  }
  class Visit {
    -visitId, patientId : String
    -service : Service
    -status : VisitStatus
    -priorityCategory : PriorityCategory
    -queueNumber : String
    -arrivalOrder, missedCount
    -consultStart, consultEnd
    -outcomeType : ConsultOutcome
  }
  class Appointment {
    -appointmentId, patientId : String
    -linkedVisitId : String
    -dateTime : LocalDateTime
    -service : Service
    -status : AppointmentStatus
    -checkInVisitId : String
  }
  class RecordVersion {
    -patientId : String
    -versionNumber : int
    -copy of all record fields
    -changedField : RecordField
    -oldValue, newValue : String
    -changedBy, changedAt, action
  }
  class User
  class DuplicateFlag
  enum "Role, Permission, Service, Sex,\nVisitType, VisitStatus, PriorityCategory,\nConsultOutcome, AppointmentStatus,\nRecordField" as Enums
}

package "service" {
  class AuthService {
    -users : HashMap<String, User>
    -rolePermissions : HashMap<Role, Set<Permission>>
  }
  class PatientService {
    -patients : HashMap<String, Patient>
    -duplicateIndex : HashMap<String, ArrayList<String>>
    +afterIdentityChange(...)
  }
  class VisitService {
    -visits : HashMap<String, Visit>
    -activeQueueNumbers : HashSet<String>
    -priorityLane : EnumMap<Service, LinkedQueue<Visit>>
    -regularLine : EnumMap<Service, LinkedQueue<Visit>>
    +createVisit(...) +callNext(...)
    +markMissed(...) +recordOutcome(...)
  }
  class RecordHistory {
    -history : HashMap<String, VersionStack<RecordVersion>>
    +updateField(user, patientId, field, value)
    +getHistory(user, patientId)
    +restore(user, patientId, version)
    +undoLatest(user, patientId)
  }
  class AppointmentService {
    -schedule : TreeMap<LocalDateTime, ArrayList<Appointment>>
    -byId : HashMap<String, Appointment>
    -followUpByVisit : HashMap<String, String>
    +book(...) +reschedule(...) +cancel(...)
    +upcoming() tailMap  +missed() headMap
    +onDay() subMap  +checkIn(...)
    +followUpsToBook(...)
  }
}

package "ds (hand-coded)" {
  class AuditLog <<linked list>> {
    +add(entry)  O(1)
    +byUser() byTarget() byAction()  O(n)
  }
  class LinkedQueue<T> <<queue>> {
    +enqueue(item)  O(1)
    +dequeue()  O(1)
    +remove(item)  O(n)
  }
  class VersionStack<T> <<stack>> {
    +push(item)  O(1)
    +pop()  O(1)
    +peek()  O(1)
  }
}

package "util / io / exception" {
  class Validator <<static>>
  class FileHandler {
    +loadAll(...)
    +saveAll(...)
  }
  class "InvalidInputException,\nAccessDeniedException" as Exceptions
}

class Main

Main --> AuthService
Main --> PatientService
Main --> VisitService
Main --> RecordHistory
Main --> AppointmentService
Main --> FileHandler
VisitService --> PatientService
VisitService --> LinkedQueue
RecordHistory --> PatientService
RecordHistory --> VersionStack
RecordHistory "1" o-- "*" RecordVersion
AppointmentService --> VisitService : check-in creates a visit
AppointmentService "1" o-- "*" Appointment
PatientService "1" o-- "*" Patient
PatientService "1" o-- "*" DuplicateFlag
VisitService "1" o-- "*" Visit
AuthService "1" o-- "*" User
Patient "1" -- "*" Visit
Appointment --> Visit : follow-up of
AuthService --> AuditLog
PatientService ..> Validator
@enduml
